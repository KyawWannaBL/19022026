{
  "$schema": "https://supabase.com/dashboard/project/dltavabvjwocknkyvwgz/database/schemas",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/hooks/useAuth.ts", "src/hooks/useAuth.js"],
  "references": [{ "path": "./tsconfig.node.json" }]
}